# ==========================================
# CẤU HÌNH TÀI KHOẢN (ACCOUNT PROFILE)
# ==========================================
# Định danh nội bộ của tài khoản (không nhạy cảm)
ACCOUNT_ID=acc_manager_01

# Đường dẫn lưu session token sau khi quét mã QR
SESSION_PATH=./session.json

# Đường dẫn lưu ảnh mã QR tạm thời khi cần đăng nhập
QR_PATH=./qr.png

# Danh sách ID các nhóm khách hàng ĐƯỢC PHÉP TRUY CẬP (phân cách bằng dấu phẩy)
# Worker sẽ chỉ đọc và lưu dữ liệu từ các nhóm nằm trong danh sách này
ALLOWED_GROUP_IDS=1234567890123456789,9876543210987654321

# ID nhóm đơn lẻ phục vụ test nhanh (tùy chọn)
GROUP_ID=1234567890123456789

# ==========================================
# CẤU HÌNH MẠNG & EGRESS IP (TÙY CHỌN)
# ==========================================
# Cấu hình proxy nếu cần cố định IP egress cho tài khoản
# Ví dụ: http://username:password@proxy-host:port hoặc socks5://...
EGRESS_PROXY_URL=

# Địa chỉ IP public cố định kỳ vọng (nếu môi trường yêu cầu xác minh)
EXPECTED_EGRESS_IP=

# Bật kiểm tra IP egress trước khi khởi động worker (true/false)
VERIFY_EGRESS_IP=false

# ==========================================
# CẤU HÌNH LƯU TRỮ (STORAGE)
# ==========================================
# Thư mục gốc lưu trữ dữ liệu JSON (raw, normalized, checkpoints)
STORAGE_DIR=./storage

# Thư mục lưu trữ media (ảnh, video, file tải về)
MEDIA_DIR=./storage/media

# Thư mục xuất file tương thích POC cũ
OUTPUT_DIR=./output

# ==========================================
# CẤU HÌNH VẬN HÀNH & SYNC ENGINE
# ==========================================
# Số lượng tin nhắn cần lấy mỗi batch (khuyến nghị 10-30 tin)
MESSAGE_COUNT=20

# Delay an toàn giữa các request để tránh rate-limit Zalo (milliseconds)
RATE_LIMIT_DELAY_MS=1500

# Tối đa số lần retry khi gặp lỗi mạng tạm thời
MAX_RETRIES=3

# Tự động tải media kèm theo tin nhắn khi có URL hợp lệ (true/false)
AUTO_DOWNLOAD_MEDIA=true

# Số luồng tải media đồng thời tối đa trong hàng đợi nền (concurrency)
MEDIA_CONCURRENCY=3

# Giới hạn kích thước media tối đa được phép tải về (bytes, mặc định 25MB)
MAX_MEDIA_SIZE_BYTES=26214400

